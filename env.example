PHX_HOST=localhost
TOPICS_CLUB_BIND_IP=127.0.0.1
TOPICS_CLUB_PORT=4000
# Optional exact Git SHA; Docker derives a source digest when blank.
SOURCE_REVISION=
TOPICS_CLUB_POSTGRES_DATA=/srv/ircpipe/postgres
POSTGRES_PASSWORD=change-me
SECRET_KEY_BASE=generate-with-mix-phx-gen-secret
# Generate with: mix topics_club.gen_credentials_key
IRC_CREDENTIALS_KEY=generate-with-32-random-bytes-encoded-with-base64
POOL_SIZE=10

# Web Push. Generate the keypair with: mix topics_club.gen_vapid_keys
VAPID_PUBLIC_KEY=replace-with-generated-public-key
VAPID_PRIVATE_KEY=replace-with-generated-private-key
# Use a plain email address; the app adds the required mailto: prefix.
VAPID_SUBJECT=notifications@example.com

# Discovery workers are disabled in production unless explicitly enabled.
ENABLE_DISCOVERY=false

# Optional Google OAuth. Leave blank to hide Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional SMTP for registration and magic-link emails.
# Without SMTP, use OAuth or provision users another way.
SMTP_RELAY=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=if_available
SMTP_SSL=false
EMAIL_FROM_NAME=Ircpipe
EMAIL_FROM_ADDRESS=ircpipe@example.com
