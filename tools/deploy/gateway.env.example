# Copy this list to /etc/topics-club/gateway.env on the destination host.
# Replace every placeholder there. Never commit the resulting file.
DATABASE_URL=replace-on-host
IRC_CREDENTIALS_KEY=replace-on-host
SECRET_KEY_BASE=replace-on-host
GATEWAY_HOST=replace-on-host
PORT=4000
GOOGLE_CLIENT_ID=replace-on-host
GOOGLE_CLIENT_SECRET=replace-on-host
VAPID_PUBLIC_KEY=replace-on-host
VAPID_PRIVATE_KEY=replace-on-host
VAPID_SUBJECT=replace-on-host
ENABLE_DISCOVERY=false
RELEASE_NODE=topics_club_gateway@localhost
RELEASE_COOKIE=replace-on-host
