[Unit]
Description=TopicsClub IRC engine
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5
ConditionPathExists=/srv/topics-club/current-engine/bin/topics_club_engine

[Service]
Type=simple
User=topics-club-engine
Group=topics-club-engine
WorkingDirectory=/var/lib/topics-club/engine
EnvironmentFile=/etc/topics-club/engine.env
Environment=HOME=/var/lib/topics-club/engine
Environment=RELEASE_TMP=/var/lib/topics-club/engine/tmp
Environment=ERL_CRASH_DUMP=/var/lib/topics-club/engine/erl_crash.dump
Environment=ERL_EPMD_ADDRESS=127.0.0.1
ExecStart=/srv/topics-club/current-engine/bin/topics_club_engine start
KillSignal=SIGTERM
TimeoutStartSec=90
TimeoutStopSec=90
Restart=on-failure
RestartSec=5
UMask=0027
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/topics-club/engine

[Install]
WantedBy=multi-user.target
