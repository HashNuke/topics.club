[Unit]
Description=Check the TopicsClub engine marker
After=topics-club-engine.service
Requires=topics-club-engine.service
ConditionPathExists=/srv/topics-club/current-engine/bin/topics_club_engine

[Service]
Type=oneshot
User=topics-club-engine
Group=topics-club-engine
WorkingDirectory=/var/lib/topics-club/engine
EnvironmentFile=/etc/topics-club/engine.env
EnvironmentFile=/etc/topics-club/db.env
Environment=HOME=/var/lib/topics-club/engine
Environment=RELEASE_TMP=/var/lib/topics-club/engine/tmp
Environment=ERL_EPMD_ADDRESS=127.0.0.1
ExecStart=/srv/topics-club/current-engine/bin/topics_club_engine rpc "_ = :sys.get_state(TopicsClub.Irc.Bouncer); case TopicsClub.Engine.Diagnostics.snapshot() do %%{marker: %%{status: :owner}} -> :ok; state -> raise \"engine is not ready: #{inspect(state)}\" end"
TimeoutStartSec=30
UMask=0027
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/topics-club/engine
