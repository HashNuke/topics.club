[Unit]
Description=TopicsClub gateway
After=network-online.target postgresql.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5
ConditionPathExists=/srv/topics-club/current-gateway/bin/server

[Service]
Type=simple
User=topics-club-gateway
Group=topics-club-gateway
WorkingDirectory=/var/lib/topics-club/gateway
EnvironmentFile=/etc/topics-club/gateway.env
EnvironmentFile=/etc/topics-club/db.env
Environment=HOME=/var/lib/topics-club/gateway
Environment=RELEASE_TMP=/var/lib/topics-club/gateway/tmp
Environment=ERL_CRASH_DUMP=/var/lib/topics-club/gateway/erl_crash.dump
Environment=ERL_EPMD_ADDRESS=127.0.0.1
Environment=PHX_IP=127.0.0.1
ExecStart=/srv/topics-club/current-gateway/bin/server
KillSignal=SIGTERM
TimeoutStartSec=90
TimeoutStopSec=60
Restart=on-failure
RestartSec=5
UMask=0027
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/topics-club/gateway

[Install]
WantedBy=multi-user.target
