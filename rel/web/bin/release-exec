#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -P -- "$(dirname -- "$0")" && pwd)

for candidate in "$script_dir"/*; do
  case "$(basename -- "$candidate")" in
    migrate | release-exec | server | *.bat) continue ;;
  esac

  if [ -f "$candidate" ] && [ -x "$candidate" ]; then
    exec "$candidate" "$@"
  fi
done

echo "release executable not found in $script_dir" >&2
exit 1
