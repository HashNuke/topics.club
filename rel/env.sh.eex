#!/bin/sh

case "$RELEASE_NAME" in
  topics_club_gateway)
    : "${RELEASE_NODE:?RELEASE_NODE is required for the split gateway release}"
    : "${RELEASE_COOKIE:?RELEASE_COOKIE is required for the split gateway release}"
    : "${TOPICS_CLUB_ENGINE_NODE:?TOPICS_CLUB_ENGINE_NODE is required for the split gateway release}"
    export RELEASE_DISTRIBUTION=name

    case "$RELEASE_COMMAND" in
      start|start_iex|daemon|daemon_iex)
        export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-} -kernel inet_dist_listen_min 4370 inet_dist_listen_max 4370"
        ;;
    esac
    ;;
  topics_club_engine)
    : "${RELEASE_NODE:?RELEASE_NODE is required for the split engine release}"
    : "${RELEASE_COOKIE:?RELEASE_COOKIE is required for the split engine release}"
    export RELEASE_DISTRIBUTION=name

    case "$RELEASE_COMMAND" in
      start|start_iex|daemon|daemon_iex)
        export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-} -kernel inet_dist_listen_min 4371 inet_dist_listen_max 4371"
        ;;
    esac
    ;;
  *)
    export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"
    ;;
esac
