#!/usr/bin/env sh
set -eu

script_dir=$(CDPATH= cd -P -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -P -- "$script_dir/.." && pwd)
env_file="$repo_root/.env"

usage() {
  printf '%s\n' \
    'Generate a local .env for the TopicsClub Docker Compose stack.' \
    '' \
    'Usage:' \
    '  bin/setup-compose [hostname]' \
    '' \
    'The hostname defaults to localhost. Existing .env files are never changed.'
}

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
esac

if [ "$#" -gt 1 ]; then
  usage >&2
  exit 64
fi

gateway_host=${1:-localhost}

case "$gateway_host" in
  ""|*/*|*:*|*[!A-Za-z0-9.-]*)
    printf 'error: hostname must not include a scheme, port, path, or spaces\n' >&2
    exit 64
    ;;
esac

if [ -e "$env_file" ] || [ -L "$env_file" ]; then
  printf 'Using existing %s; no changes made.\n' "$env_file"
  exit 0
fi

if ! command -v openssl >/dev/null 2>&1; then
  printf 'error: openssl is required to generate Compose secrets\n' >&2
  exit 69
fi

postgres_password=$(openssl rand -hex 32)
secret_key_base=$(openssl rand -hex 32)
irc_credentials_key=$(openssl rand -base64 32)
tmp_file=$(mktemp "$repo_root/.env.tmp.XXXXXX")

cleanup() {
  rm -f "$tmp_file"
}

trap cleanup EXIT HUP INT TERM
umask 077

{
  printf '# Generated by bin/setup-compose.\n'
  printf 'GATEWAY_HOST=%s\n' "$gateway_host"
  printf 'POSTGRES_PASSWORD=%s\n' "$postgres_password"
  printf 'SECRET_KEY_BASE=%s\n' "$secret_key_base"
  printf 'IRC_CREDENTIALS_KEY=%s\n' "$irc_credentials_key"
  printf '\n'
  printf '# Optional Web Push configuration.\n'
  printf 'VAPID_PUBLIC_KEY=\n'
  printf 'VAPID_PRIVATE_KEY=\n'
  printf 'VAPID_SUBJECT=\n'
  printf '\n'
  printf 'ENABLE_DISCOVERY=true\n'
  printf '\n'
  printf '# Google OAuth is required for production sign-in.\n'
  printf 'GOOGLE_CLIENT_ID=\n'
  printf 'GOOGLE_CLIENT_SECRET=\n'
} > "$tmp_file"

chmod 0600 "$tmp_file"

if [ -e "$env_file" ] || [ -L "$env_file" ]; then
  printf 'error: %s appeared while secrets were being generated; no changes made\n' "$env_file" >&2
  exit 73
fi

mv "$tmp_file" "$env_file"
trap - EXIT HUP INT TERM

printf 'Created %s for %s.\n' "$env_file" "$gateway_host"
